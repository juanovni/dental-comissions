APP_NAME="Dental Comisiones"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.odon-crm.com
TENANCY_BASE_DOMAIN=odon-crm.com
TENANCY_ADMIN_DOMAIN=app.odon-crm.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=dental.pgsql
DB_PORT=5432
DB_DATABASE=dental_commissions_mvp
DB_USERNAME=dental
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Dental Comisiones"

WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

AI_PROVIDER=openai
OPENAI_API_KEY=
